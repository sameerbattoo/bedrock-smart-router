{
  "_metadata": {
    "version": "0.2.0",
    "description": "Bedrock Smart Router model catalog. Pricing in USD per 1K tokens.",
    "last_updated": "2026-04-21",
    "notes": {
      "prompt_caching": "Only Anthropic Claude models have explicit prompt caching with separate cache_read/cache_write pricing. Amazon Nova has automatic prompt caching (latency benefit, no separate pricing). Meta Llama, DeepSeek, and Mistral do not support prompt caching on Bedrock \u2014 their cache_read_per_1k and cache_write_per_1k are 0.0 (not applicable, not free).",
      "pricing": "Prices are on-demand standard tier rates from public Bedrock pricing as of April 2026. Batch mode is 50% off. Priority tier may cost more. Flex tier may cost less.",
      "cris_profiles": "Only us.* profiles are listed. Most models also have global.* and eu.* profiles \u2014 add them via overlay if needed for your geography."
    }
  },
