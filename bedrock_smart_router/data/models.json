{
  "_metadata": {
    "version": "0.2.0",
    "description": "Bedrock Smart Router model catalog. Pricing in USD per 1K tokens.",
    "last_updated": "2026-04-21",
    "notes": {
      "prompt_caching": "Anthropic Claude and Amazon Nova models have prompt caching with cache_read pricing (cache reads are discounted vs regular input tokens; cache writes are free for Nova, charged for Claude). Meta Llama, DeepSeek, and Mistral do not support prompt caching on Bedrock \u2014 their cache_read_per_1k and cache_write_per_1k are 0.0.",
      "pricing": "Prices are on-demand Standard tier rates from public Bedrock pricing as of April 2026. Batch mode is 50% off. Priority tier is ~75% premium over Standard. Flex tier is ~50% discount vs Standard. Tier multipliers are applied at runtime by ModelPricing.estimate_cost(tier=...).",
      "cris_profiles": "Both us.* (regional) and global.* (cross-region, ~10% cheaper) profiles are included as separate model entries with their own pricing. The router treats them as distinct models for cost-based routing.",
      "global_pricing": "Global cross-region inference profiles offer approximately 10% savings on both input and output token pricing compared to regional (us.*) profiles. Source: AWS Bedrock documentation."
    }
  },
