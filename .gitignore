# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg
.venv/
*.whl

# IDE
.idea/
.vscode/
*.swp
*.swo

# Testing
.pytest_cache/
.coverage
htmlcov/

# OS
.DS_Store
Thumbs.db

# Secrets — never commit these
.env
.env.*
*.pem
*.key
credentials.json

# Kiro
.kiro/

# Demo prerequisite generated config
demo/prerequisite/.guardrail_config.json

# Demo generated diagrams and artifacts
demo/backend/*.png
demo/backend/*_diagram/
demo/backend/repl_state/

# Temp files
.commit_msg.txt

# Script-generated caches (auto-downloaded, large)
scripts/_litellm_models.json

# Classifier training datasets — downloaded via benchmarks/classifier/download/,
# not committed (upstream datasets have their own licenses; download fresh).
# The in-repo synthetic data under datasets/generated/ IS committed.
# To regenerate: python benchmarks/classifier/download/download_all.py
benchmarks/classifier/datasets/*.json

# Benchmark run outputs — raw per-run JSON dumps are not committed (large,
# regenerable via benchmarks/runner/run_benchmark.py). The human-readable
# REPORT.md IS committed.
benchmarks/results/*.json
